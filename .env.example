# ────────────────
# Database (PostgreSQL – Docker Compose)
# ────────────────
POSTGRES_DB=swimo_db
POSTGRES_USER=swimo_user
POSTGRES_PASSWORD=swimo_pass

# ────────────────
# Backend (FastAPI)
# ────────────────
# Development connection string used by SQLAlchemy
DATABASE_URL=postgresql://postgres:postgres@db:5432/${POSTGRES_DB}

# Optional URL for production deployments (if set it overrides DATABASE_URL)
PROD_DATABASE_URL=

# JWT signing key used for access / refresh tokens
SECRET_KEY=change_me

# TMDB API key used by seed_db.py to download posters & metadata
TMDB_API_KEY=

# ────────────────
# Frontend (Next.js)
# ────────────────
# Base URL of the FastAPI backend the UI will call
NEXT_PUBLIC_API_URL=http://localhost:8000